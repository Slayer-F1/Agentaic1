      "name": "svc: get_employee_profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -320
      ],
      "parameters": {
        "jsCode": "const j = $('Gate Check').first().json;\nconst rows = $input.all().map(i => i.json);\nconst e = rows.find(r => r.employee_id === j.employee_id);\nif (!e) return [{ json: { ...j, result: { error: 'EMPLOYEE_NOT_FOUND' } } }];\nreturn [{ json: { ...j, result: {\n  employee_id: e.employee_id, name_ar: e.name_ar, name_en: e.name_en, role: e.role,\n  department: e.department, grade: e.grade, manager_id: e.manager_id, status: e.status,\n  joined_date: e.joined_date,\n} } }];\n"
      }
    },
