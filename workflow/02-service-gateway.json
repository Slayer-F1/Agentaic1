    {
      "id": "940e7b95-cdec-4832-9781-21164182a2f9",
      "name": "Return Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        60
      ],
      "parameters": {
        "jsCode": "const src = $('Build Audit Row').first().json;\n// find the full item that produced the audit row\nlet full = null;\nfor (const n of ['Denied Result','svc: get_employee_profile','svc: get_leave_balance',\n  'svc: get_salary_record','svc: get_expense_policy','svc: get_it_roles',\n  'svc: get_system_catalog','svc: check_leave_overlap','Carry Submit Result','svc: not_implemented']) {\n  try { const it = $(n).first(); if (it && it.json && it.json.result) { full = it.json; break; } } catch (e) {}\n}\nreturn [{ json: { service: src.service, result: (full && full.result) || { error: 'NO_RESULT' } } }];\n"
      }
    },
