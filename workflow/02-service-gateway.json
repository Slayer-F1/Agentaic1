      "parameters": {
        "jsCode": "const j = $('Gate Check').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.system_id);\nconst q = (j.payload.system_id || j.payload.query || '').toLowerCase();\nconst hit = rows.filter(r => !q || r.system_id.toLowerCase().includes(q)\n  || String(r.name_ar).includes(j.payload.system_id || j.payload.query || '')\n  || String(r.name_en).toLowerCase().includes(q));\nreturn [{ json: { ...j, result: { systems: hit.map(r => ({\n  system_id: r.system_id, name_ar: r.name_ar, name_en: r.name_en,\n  sensitivity: r.sensitivity, allowed_roles: String(r.allowed_roles || '').split(';').filter(Boolean),\n})) } } }];\n"
