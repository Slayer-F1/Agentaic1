    {
      "id": "fcca2621-1850-4a8d-b034-e56b157b0fd5",
      "name": "svc: get_salary_record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        20
      ],
      "parameters": {
        "jsCode": "const j = $('Gate Check').first().json;\nconst emps = $('Read Employees (salary)').all().map(i => i.json);\nconst txns = $input.all().map(i => i.json);\nconst e = emps.find(r => r.employee_id === j.employee_id);\nif (!e) return [{ json: { ...j, result: { error: 'EMPLOYEE_NOT_FOUND' } } }];\nconst month = new Date().toISOString().slice(0, 7);\nconst certs = txns.filter(t => t.employee_id === j.employee_id && t.skill_id === 'salary-certificate'\n  && String(t.ts || '').startsWith(month) && t.status === 'executed').length;\nreturn [{ json: { ...j, result: {\n  name_ar: e.name_ar, name_en: e.name_en, role: e.role, grade: e.grade,\n  joined_date: e.joined_date, status: e.status,\n  monthly_salary_aed: +e.monthly_salary_aed, allowances_aed: +e.allowances_aed,\n  certificates_issued_this_month: certs, monthly_limit: 3,\n} } }];\n"
      }
    },
