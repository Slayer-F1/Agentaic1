        "jsCode": "const j = $('Gate Check').first().json;\nconst rows = $input.all().map(i => i.json);\nconst e = rows.find(r => r.employee_id === j.employee_id);\nif (!e) return [{ json: { ...j, result: { error: 'EMPLOYEE_NOT_FOUND' } } }];\nconst roles = String(e.it_roles || '').split(';').map(s => s.trim()).filter(Boolean);\nreturn [{ json: { ...j, result: { current_access: roles } } }];\n"
