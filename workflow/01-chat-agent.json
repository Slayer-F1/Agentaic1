      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        -220
      ],
      "parameters": {
        "jsCode": "const j = $json;\nconst prompt = ['راجع ردك: المدقق الحتمي وجد خطأً حسابيًا.', j.recheck_notes.join('؛ '),\n  'ردك السابق:', JSON.stringify({ reply_ar: j.reply_ar, state: j.state,\n    transaction_preview: j.transaction_preview, missing_fields: j.missing_fields }),\n  'صحّح الأرقام وأعد JSON بنفس المخطط تمامًا دون أي نص آخر.'].join('\\n');\nreturn [{ json: { ...j, geminiBody: { contents: [{ role: 'user', parts: [{ text: prompt }] }],\n  generationConfig: { temperature: 0, response_mime_type: 'application/json' } } } }];\n"
      }
