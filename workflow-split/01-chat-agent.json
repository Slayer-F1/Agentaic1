    {
      "id": "e0ae6dc1-1987-4656-8b1c-422249c7a385",
      "name": "Parse Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -820,
        220
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  let text = '';\n  try { text = item.json.candidates[0].content.parts.map(p => p.text || '').join(''); } catch (e) {}\n  const cleaned = text.replace(/^```(json)?/m, '').replace(/```\\s*$/m, '').trim();\n  let parsed = null;\n  try { parsed = JSON.parse(cleaned); } catch (e) {\n    const m = cleaned.match(/\\{[\\s\\S]*\\}/);\n    if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) {} }\n  }\n  out.push({ json: { gemini_text: cleaned, gemini_json: parsed, gemini_ok: !!parsed } });\n}\nreturn out;\n"
      }
    },
    {
      "id": "036dc8ba-00d0-44d2-b84d-1dbf22a3a1d4",
      "name": "Pick Skill",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        110
      ],
      "parameters": {
        "jsCode": "const prep = $('Prepare Router').first().json;\nlet skill_id = prep.active_skill_id || '';\nlet confidence = 1;\nif (!skill_id) {\n  const r = $json.gemini_json || {};\n  skill_id = r.skill_id && r.skill_id !== 'null' ? r.skill_id : '';\n  confidence = typeof r.confidence === 'number' ? r.confidence : 0;\n}\nconst skill = prep.skills.find(s => s.id === skill_id);\nreturn [{ json: { ...prep, geminiBody: undefined, skill_id: skill ? skill.id : '',\n  matched: !!skill && confidence >= 0.5,\n  skill_meta: skill || null,\n  services_list_ar: prep.skills.map(s => '• ' + s.title_ar).join('\\n') } }];\n"
      }
