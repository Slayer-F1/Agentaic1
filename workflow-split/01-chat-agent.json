        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"reply_ar\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"collecting\",\n        \"preview\",\n        \"submitted\",\n        \"rejected\",\n        \"escalated\",\n        \"info\"\n      ]\n    },\n    \"transaction_preview\": {\n      \"type\": [\n        \"object\",\n        \"null\"\n      ],\n      \"properties\": {\n        \"fields\": {\n          \"type\": \"object\"\n        },\n        \"working_days\": {\n          \"type\": [\n            \"number\",\n            \"null\"\n          ]\n        },\n        \"amount_aed\": {\n          \"type\": [\n            \"number\",\n            \"null\"\n          ]\n        },\n        \"approval_chain\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"warnings\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"txn_id\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"missing_fields\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"reply_ar\",\n    \"state\"\n  ]\n}"
      }
