    {
      "id": "f8a226d8-a851-4887-b8b2-34c607990817",
      "name": "Find Stale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        40
      ],
      "parameters": {
        "jsCode": "const d = $json;\nconst now = Date.now();\nconst emps = d.employees || [];\nconst byId = {}; for (const e of emps) byId[e.employee_id] = e;\nconst cases = [];\nfor (const t of (d.transactions || [])) {\n  if (!String(t.status || '').startsWith('awaiting_')) continue;\n  const ageH = (now - new Date(t.updated_at || t.ts).getTime()) / 36e5;\n  const sla = +t.sla_hours || 48;\n  if (ageH < sla * 0.5) continue;\n  const owner = byId[t.employee_id] || {};\n  const mgr = byId[owner.manager_id] || {};\n  cases.push({ txn_id: t.txn_id, type_ar: t.type_ar, employee: t.employee_name,\n    stage: t.current_approver, age_hours: Math.round(ageH * 10) / 10, sla_hours: sla,\n    breached: ageH > sla, approver_email: t.current_approver === 'manager' ? (mgr.email || '') : '',\n  });\n}\nreturn [{ json: { cases, case_count: cases.length, now: new Date().toISOString() } }];\n"
      }
    },
    {
      "id": "81243be4-7656-49ef-9cba-bac39d387c37",
      "name": "Any Stale?",
      "type": "n8n-nodes-base.if",
