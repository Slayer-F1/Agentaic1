      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        -40
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: {\n  ts: i.json.ts, session_id: 'sla-chaser', employee_id: '',\n  skill_id: '', service: 'sla_' + i.json.action,\n  request_json: JSON.stringify({ txn_id: i.json.txn_id, hours_late: i.json.age_hours }),\n  result_summary: i.json.justification_ar || '' } }));\n"
      }
    },
