        "text": "={{ 'المعاملات المتأخرة عن سلسلة الاعتماد (' + $json.now + '):\\n' + JSON.stringify($json.cases) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "أنت «حارس الإنجاز» في بوابة مُنجِز. لكل معاملة متأخرة قرر: remind_approver (اقتربت من sla ولم تُذكَّر)، escalate (تجاوزت sla — تصعيد للإدارة العليا)، أو wait (قريبة العهد). اكتب مسوّغًا عربيًا رسميًا موجزًا لكل قرار — يُحفظ في سجل التدقيق. أعد JSON فقط.",
          "maxIterations": 6,
          "returnIntermediateSteps": true
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 15000
    },
