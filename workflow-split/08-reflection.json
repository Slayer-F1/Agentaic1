      "parameters": {
        "promptType": "define",
        "text": "={{ 'ميثاق المراجعة:\\n' + ($json.body_md || '') + '\\n\\nدفعة المعاملات الأخيرة:\\n' + JSON.stringify($('Gather Batch').first().json.batch) + '\\n\\nحالات رفض الحوكمة:\\n' + JSON.stringify($('Gather Batch').first().json.denials) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "أنت «مراجع ما بعد الدور» في منظومة مُنجِز. تعمل بعد أن حصل الموظفون على إجاباتهم، ومهمتك الوحيدة تحسين ذاكرة المنظومة ومهاراتها. التزم حرفيًا بميثاق المراجعة المحمّل أدناه، وخصوصًا القائمة السلبية والفصل بين الذاكرة والمهارة. ابدأ دائمًا بـ read_memory قبل أي كتابة. مرور بلا تحديث = فرصة ضائعة، لكن لا تكتب ما تمنعه القائمة السلبية. أعد JSON فقط.",
          "maxIterations": 12,
          "returnIntermediateSteps": true
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 15000
    },
